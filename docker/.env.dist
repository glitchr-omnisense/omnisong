# The catalogues' settings: copy to .env (git-ignored), fill in what you have.
# `docker compose run --rm omnisong catalogs` says what is installed and configured.

# Where the catalogues' checkouts are, when this core sits in the workspace
# beside them (../.. from this directory); unset, they come from GitHub.
#OMNISONG_PLUGINS=../..

# omnisense/contracts, the kernel the family builds on: its checkout when it sits
# beside the family's folder; unset, it comes from GitHub (its tests then do not run).
#OMNISENSE_CONTRACTS=../../../omnisense-contracts

# Odesli (song.link): a key from developers@song.link. Without one the API
# answers 401 (its keyless access is withdrawn): the catalogue is then skipped,
# and the commands say so.
ODESLI_API_KEY=
ODESLI_COUNTRY=DE

# iTunes Search API: no key; the store asked.
ITUNES_COUNTRY=de
